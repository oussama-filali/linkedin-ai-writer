# Base de données PostgreSQL (utilise ElephantSQL gratuit ou Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/linkedin_ai_writer

# OpenAI API Key (obtiens-la sur https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-real-key-here

# Configuration serveur
PORT=3000
NODE_ENV=development

# JWT Secret pour authentification
JWT_SECRET=your-super-secret-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
